# identity settings for running on the host (make run / migrate-* / test-integration).
#
#   cp .env.example .env      # .env is git-ignored; this file is committed
#
# The Makefile sources .env with `set -a; . ./.env`, so this is shell syntax:
# quote a value that contains spaces, & or ;. The URLs below match the
# placeholders in back/deploy/.env.example; if you changed the passwords
# there, change them here too. Compose does NOT read this file (compose.yaml
# builds in-network URLs from back/deploy/.env).

# --- Required -----------------------------------------------------------------

IDENTITY_DATABASE_URL=postgres://identity:change-me-identity@127.0.0.1:15432/identity?sslmode=disable

# --- Dependencies (empty disables the feature, with a warning) -------------------

# Outbox relay. Empty: events stay in the outbox table.
IDENTITY_KAFKA_BROKERS=localhost:19092

# --- Servers --------------------------------------------------------------------

# Loopback on non-default host ports (the same ones compose.yaml publishes, so
# run either the local binary or the container, not both).
IDENTITY_GRPC_ADDR=127.0.0.1:15051
IDENTITY_HTTP_ADDR=127.0.0.1:18051
# Server reflection for grpcurl. Local development only.
IDENTITY_GRPC_REFLECTION=true

IDENTITY_LOG_LEVEL=debug
IDENTITY_LOG_FORMAT=text

# --- Background work ------------------------------------------------------------

IDENTITY_OUTBOX_INTERVAL=1s

# --- Tests ----------------------------------------------------------------------

# `make test-integration` runs against this database. Each run creates a
# temporary schema, migrates it and drops it; nothing else is touched.
IDENTITY_TEST_DATABASE_URL=postgres://identity:change-me-identity@127.0.0.1:15432/identity?sslmode=disable
