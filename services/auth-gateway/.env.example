# auth-gateway settings for running on the host (make run / migrate-* / test-integration).
#
#   cp .env.example .env      # .env is git-ignored; this file is committed
#   make dev-key              # writes secrets/jwt-es256.pem (git-ignored)
#
# The Makefile sources .env with `set -a; . ./.env`, so this is shell syntax:
# quote a value that contains spaces, & or ;. The URLs below match the
# placeholders in back/deploy/.env.example; if you changed the passwords
# there, change them here too. Compose does NOT read this file (compose.yaml
# builds in-network URLs from back/deploy/.env).
#
# NEVER put a private key in this file. Only the path to one.

# --- Required -----------------------------------------------------------------

AUTH_GATEWAY_DATABASE_URL=postgres://auth_gateway:change-me-auth-gateway@127.0.0.1:15432/auth_gateway?sslmode=disable
# identity gRPC: local binary or container on 127.0.0.1:15051 (identity:50051 in compose).
AUTH_GATEWAY_IDENTITY_ADDR=127.0.0.1:15051

# --- Access token signing key ---------------------------------------------------
# One of the two, or the service refuses to start. FILE is for the host, the
# inline PEM (raw or base64) is for containers and secret managers.

AUTH_GATEWAY_JWT_PRIVATE_KEY_FILE=./secrets/jwt-es256.pem
#AUTH_GATEWAY_JWT_PRIVATE_KEY=
# Retired public keys, still served by GetJwks during a rotation (PEM or
# base64 PEM, comma-separated).
#AUTH_GATEWAY_JWT_PREVIOUS_PUBLIC_KEYS=

AUTH_GATEWAY_JWT_ISSUER=https://auth.agrogram.local
AUTH_GATEWAY_JWT_AUDIENCE=agrogram-api
AUTH_GATEWAY_ACCESS_TOKEN_TTL=15m
AUTH_GATEWAY_REFRESH_TOKEN_TTL=720h

# --- Dependencies (empty disables the feature, with a warning) -------------------

# Sign-in and SMS code rate limits. Empty: no rate limiting.
AUTH_GATEWAY_REDIS_URL=redis://:change-me-redis@127.0.0.1:16379/0
# Outbox relay. Empty: security notification requests stay in the outbox table.
AUTH_GATEWAY_KAFKA_BROKERS=localhost:19092

# --- Servers --------------------------------------------------------------------

# Loopback on non-default host ports (the same ones compose.yaml publishes, so
# run either the local binary or the container, not both).
AUTH_GATEWAY_GRPC_ADDR=127.0.0.1:15052
AUTH_GATEWAY_HTTP_ADDR=127.0.0.1:18052
# Server reflection for grpcurl. Local development only.
AUTH_GATEWAY_GRPC_REFLECTION=true

AUTH_GATEWAY_LOG_LEVEL=debug
AUTH_GATEWAY_LOG_FORMAT=text

# --- identity client ------------------------------------------------------------

AUTH_GATEWAY_IDENTITY_TIMEOUT=3s

# --- Phone codes (SMS delivery is a STUB; nothing is ever sent) ------------------

AUTH_GATEWAY_PHONE_CODE_TTL=10m
AUTH_GATEWAY_PHONE_CODE_RESEND=60s
AUTH_GATEWAY_PHONE_CODE_LENGTH=6
AUTH_GATEWAY_PHONE_CODE_MAX_ATTEMPTS=5
# STUB, local development only: a fixed code so the phone flow works offline.
# Leave it empty anywhere else; then the code is random and only readable with
# AUTH_GATEWAY_DEV_LOG_PHONE_CODES=true.
AUTH_GATEWAY_DEV_PHONE_CODE=123456
AUTH_GATEWAY_DEV_LOG_PHONE_CODES=true

# --- Rate limits ----------------------------------------------------------------

AUTH_GATEWAY_PHONE_CODE_RATE_LIMIT=5
AUTH_GATEWAY_PHONE_CODE_RATE_WINDOW=1h
AUTH_GATEWAY_SIGN_IN_RATE_LIMIT=10
AUTH_GATEWAY_SIGN_IN_RATE_WINDOW=15m

# --- Passwords (argon2id) -------------------------------------------------------

AUTH_GATEWAY_ARGON2_MEMORY_KIB=65536
AUTH_GATEWAY_ARGON2_TIME=3
AUTH_GATEWAY_ARGON2_PARALLELISM=2

# --- Internal callers -----------------------------------------------------------

# VerifyToken is internal: only this x-agrogram-caller may call it. Empty
# disables the check (handy for grpcurl).
AUTH_GATEWAY_VERIFY_TOKEN_CALLER=api-gateway

# --- Background work ------------------------------------------------------------

AUTH_GATEWAY_OUTBOX_INTERVAL=1s

# --- Tests ----------------------------------------------------------------------

# `make test-integration` runs against this database. Each run creates a
# temporary schema, migrates it and drops it; nothing else is touched.
AUTH_GATEWAY_TEST_DATABASE_URL=postgres://auth_gateway:change-me-auth-gateway@127.0.0.1:15432/auth_gateway?sslmode=disable
