# profile-social settings for running on the host (make run / migrate-* / test-integration).
#
#   cp .env.example .env      # .env is git-ignored; this file is committed
#
# The Makefile sources .env with `set -a; . ./.env`, so this is shell syntax:
# quote a value that contains spaces, & or ;. The URLs below match the
# placeholders in back/deploy/.env.example; if you changed the passwords
# there, change them here too. Compose does NOT read this file (compose.yaml
# builds in-network URLs from back/deploy/.env).

# --- Required -----------------------------------------------------------------

PROFILE_SOCIAL_DATABASE_URL=postgres://profile_social:change-me-profile-social@127.0.0.1:15432/profile_social?sslmode=disable

# --- Dependencies (empty disables the feature, with a warning) -------------------

# Follow/unfollow rate limit. Empty: no rate limiting.
PROFILE_SOCIAL_REDIS_URL=redis://:change-me-redis@127.0.0.1:16379/0
# Account-stream consumer and outbox relay. Empty: no account updates are
# applied and RatingUpdated events stay in the outbox table.
PROFILE_SOCIAL_KAFKA_BROKERS=localhost:19092
# catalog gRPC, for ListUserListings. TODO(catalog): catalog is not built yet;
# empty answers an empty page (with a warning). Once it runs locally, e.g.
# 127.0.0.1:15054 (catalog:50051 in compose).
PROFILE_SOCIAL_CATALOG_ADDR=

# --- Servers --------------------------------------------------------------------

# Loopback on non-default host ports (the same ones compose.yaml publishes, so
# run either the local binary or the container, not both).
PROFILE_SOCIAL_GRPC_ADDR=127.0.0.1:15053
PROFILE_SOCIAL_HTTP_ADDR=127.0.0.1:18053
# Server reflection for grpcurl. Local development only.
PROFILE_SOCIAL_GRPC_REFLECTION=true

PROFILE_SOCIAL_LOG_LEVEL=debug
PROFILE_SOCIAL_LOG_FORMAT=text

# --- catalog client ---------------------------------------------------------------

PROFILE_SOCIAL_CATALOG_TIMEOUT=2s

# --- Follow rate limit ------------------------------------------------------------

PROFILE_SOCIAL_FOLLOW_RATE_LIMIT=100
PROFILE_SOCIAL_FOLLOW_RATE_WINDOW=1h

# --- Account-stream consumer ------------------------------------------------------

# Consumer group (also DeadLetter.consumer_group); dead letters go to
# agrogram.profilesocial.deadletter.v1.
PROFILE_SOCIAL_KAFKA_CONSUMER_GROUP=profilesocial
# Retry budget for records that fail for a reason other than an outage.
PROFILE_SOCIAL_CONSUMER_MAX_ATTEMPTS=5
PROFILE_SOCIAL_CONSUMER_RETRY_BACKOFF=500ms
PROFILE_SOCIAL_CONSUMER_RETRY_BACKOFF_MAX=30s

# --- Background work ------------------------------------------------------------

PROFILE_SOCIAL_OUTBOX_INTERVAL=1s

# --- Tests ----------------------------------------------------------------------

# `make test-integration` runs against this database. Each run creates a
# temporary schema, migrates it and drops it; nothing else is touched.
PROFILE_SOCIAL_TEST_DATABASE_URL=postgres://profile_social:change-me-profile-social@127.0.0.1:15432/profile_social?sslmode=disable
