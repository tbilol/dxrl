# order-escrow settings for running on the host (make run / migrate-* / test-integration).
#
#   cp .env.example .env      # .env is git-ignored; this file is committed
#
# The Makefile sources .env with `set -a; . ./.env`, so this is shell syntax:
# quote a value that contains spaces, & or ;. The URLs below match the
# placeholders in back/deploy/.env.example (ORDER_ESCROW_DB_PASSWORD); if you
# changed the password there, change it here too (percent-encode characters
# that are special in URLs). Compose does NOT read this file (compose.yaml
# builds in-network URLs from back/deploy/.env).
#
# Durations use the Go services' syntax (500ms, 2s, 1h30m); booleans true/false.

# --- Required -----------------------------------------------------------------

ORDER_ESCROW_DATABASE_URL=postgres://order_escrow:change-me-order-escrow@127.0.0.1:15432/order_escrow?sslmode=disable

# --- Dependencies (empty disables the feature, with a warning) -------------------

# catalog gRPC: CreateTransaction snapshots the listing through GetListing.
# Empty: CreateTransaction answers DEPENDENCY_UNAVAILABLE. catalog's local
# binary or container listens on 127.0.0.1:15054 (catalog:50051 in compose).
ORDER_ESCROW_CATALOG_ADDR=127.0.0.1:15054
# Outbox relay of the transaction stream (agrogram.orderescrow.transaction.v1).
# Empty: transaction events stay in the outbox table.
ORDER_ESCROW_KAFKA_BROKERS=localhost:19092

# --- Servers --------------------------------------------------------------------

# Loopback on non-default host ports (the same ones compose.yaml publishes, so
# run either the local jar or the container, not both).
ORDER_ESCROW_GRPC_ADDR=127.0.0.1:15055
ORDER_ESCROW_HTTP_ADDR=127.0.0.1:18055
# Server reflection for grpcurl. Local development only.
ORDER_ESCROW_GRPC_REFLECTION=true

ORDER_ESCROW_LOG_LEVEL=debug
ORDER_ESCROW_LOG_FORMAT=text

# --- catalog client ---------------------------------------------------------------

ORDER_ESCROW_CATALOG_TIMEOUT=2s

# --- Stubs ------------------------------------------------------------------------

# STUB TODO(bonus): the bonus rule is not designed. Placeholder points credited
# to the reseller on completion (BonusAwarded); 0 publishes no BonusAwarded.
ORDER_ESCROW_BONUS_PLACEHOLDER_POINTS=1

# --- Background work ------------------------------------------------------------

ORDER_ESCROW_OUTBOX_INTERVAL=1s

# --- Tests ----------------------------------------------------------------------

# `make test-integration` runs against this database. Each run creates a
# temporary schema, migrates it and drops it; nothing else is touched.
ORDER_ESCROW_TEST_DATABASE_URL=postgres://order_escrow:change-me-order-escrow@127.0.0.1:15432/order_escrow?sslmode=disable
