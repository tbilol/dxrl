# catalog settings for running on the host (make run / migrate-* / test-integration).
#
#   cp .env.example .env      # .env is git-ignored; this file is committed
#
# The Makefile sources .env with `set -a; . ./.env`, so this is shell syntax:
# quote a value that contains spaces, & or ;. The URLs below match the
# placeholders in back/deploy/.env.example; if you changed the passwords
# there, change them here too. Compose does NOT read this file (compose.yaml
# builds in-network URLs from back/deploy/.env).

# --- Required -----------------------------------------------------------------

CATALOG_DATABASE_URL=postgres://catalog:change-me-catalog@127.0.0.1:15432/catalog?sslmode=disable

# --- Dependencies (empty disables the feature, with a warning) -------------------

# Listing-creation rate limit and view de-duplication. Empty: no rate limit,
# every view counts.
CATALOG_REDIS_URL=redis://:change-me-redis@127.0.0.1:16379/0
# Outbox relay of the listing stream (agrogram.catalog.listing.v1) and the
# consumer of order-escrow's transaction stream (escrow commitments: remaining
# quantity, SOLD_OUT, transaction parties reading their listings). Empty:
# ListingCreated events stay in the outbox table and escrow transactions are
# not seen (remaining quantities stay at the posted quantity).
CATALOG_KAFKA_BROKERS=localhost:19092

# --- Servers --------------------------------------------------------------------

# Loopback on non-default host ports (the same ones compose.yaml publishes, so
# run either the local binary or the container, not both). profile-social
# reaches the local binary at PROFILE_SOCIAL_CATALOG_ADDR=127.0.0.1:15054.
CATALOG_GRPC_ADDR=127.0.0.1:15054
CATALOG_HTTP_ADDR=127.0.0.1:18054
# Server reflection for grpcurl. Local development only.
CATALOG_GRPC_REFLECTION=true

CATALOG_LOG_LEVEL=debug
CATALOG_LOG_FORMAT=text

# --- Plan quotas: ACTIVE listings per owner and board ----------------------------

CATALOG_OFFER_QUOTA_DEFAULT=5
CATALOG_OFFER_QUOTA_PREMIUM=20
CATALOG_BUY_REQUEST_QUOTA_DEFAULT=5
CATALOG_BUY_REQUEST_QUOTA_PREMIUM=25

# --- Listing-creation rate limit (per user; fails open without Redis) -----------

CATALOG_CREATE_RATE_LIMIT=30
CATALOG_CREATE_RATE_WINDOW=1h

# --- View counting ----------------------------------------------------------------

CATALOG_VIEWS_FLUSH_INTERVAL=2s
# A viewer counts once per listing per window (Redis); 0 counts every view.
CATALOG_VIEWS_DEDUP_WINDOW=24h

# --- Stream consumer (order-escrow's transaction stream) --------------------------

# The consumer group of the transaction stream; also DeadLetter.consumer_group.
# Dead letters go to agrogram.catalog.deadletter.v1. A new group starts at the
# beginning of the topic.
CATALOG_KAFKA_CONSUMER_GROUP=catalog
CATALOG_KAFKA_TRANSACTION_TOPIC=agrogram.orderescrow.transaction.v1
# Retry budget for records that fail for a reason other than an outage.
CATALOG_CONSUMER_MAX_ATTEMPTS=5
CATALOG_CONSUMER_RETRY_BACKOFF=500ms
CATALOG_CONSUMER_RETRY_BACKOFF_MAX=30s

# --- Background work ------------------------------------------------------------

CATALOG_OUTBOX_INTERVAL=1s

# --- Tests ----------------------------------------------------------------------

# `make test-integration` runs against this database. Each run creates a
# temporary schema, migrates it and drops it; nothing else is touched.
CATALOG_TEST_DATABASE_URL=postgres://catalog:change-me-catalog@127.0.0.1:15432/catalog?sslmode=disable
