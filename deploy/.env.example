# AGROGRAM local infrastructure settings, read by deploy/docker-compose.yml.
#
# First time, from back/:
#
#   cp deploy/.env.example deploy/.env
#
# then change the passwords in deploy/.env (the copied placeholders do work for
# a purely local stack). deploy/.env is git-ignored. This file is committed,
# so never put real secrets in it. Compose reads deploy/.env automatically
# because it sits next to docker-compose.yml; variables exported in your shell
# take precedence over it.
#
# Passwords: letters, digits, - and _ only (e.g. `openssl rand -hex 16`). They
# end up in connection URLs, where @ : / ? # % need escaping, and Compose would
# try to interpolate a $.
#
# PostgreSQL applies the passwords only when its volume is first created. To
# change them later, see "Changing passwords" in deploy/README.md.

# --- Exposure -----------------------------------------------------------------

# Host address every published port binds to. 127.0.0.1 keeps the stack
# private to this machine. 0.0.0.0 exposes it to the LAN, including both UIs,
# which have no login; if you do that, also set KAFKA_EXTERNAL_HOST.
BIND_ADDRESS=127.0.0.1

# --- Host ports ---------------------------------------------------------------
# Non-default on purpose, so they do not clash with natively installed servers
# (5432, 6379, 9092, 8080). Containers on the agrogram network use the service
# name and the standard port instead: postgres:5432, redis:6379, kafka:9092.

# PostgreSQL
POSTGRES_PORT=15432
# Redis
REDIS_PORT=16379
# Kafka, EXTERNAL listener for clients on the host (bootstrap localhost:19092)
KAFKA_PORT=19092
# Kafka UI, http://127.0.0.1:18080
KAFKA_UI_PORT=18080
# Adminer (PostgreSQL UI), http://127.0.0.1:18081
ADMINER_PORT=18081

# --- PostgreSQL ---------------------------------------------------------------

# Superuser, for administration only. Services never use it.
POSTGRES_SUPERUSER=postgres
POSTGRES_SUPERUSER_PASSWORD=change-me-postgres-superuser

# One login role per service. It has the same name as its database and is the
# only non-superuser that can connect to that database.
# Role and database auth_gateway
AUTH_GATEWAY_DB_PASSWORD=change-me-auth-gateway
# Role and database identity
IDENTITY_DB_PASSWORD=change-me-identity
# Role and database profile_social
PROFILE_SOCIAL_DB_PASSWORD=change-me-profile-social
# Role and database catalog
CATALOG_DB_PASSWORD=change-me-catalog

# --- Redis --------------------------------------------------------------------

# requirepass; clients authenticate with it (no ACL user name).
REDIS_PASSWORD=change-me-redis

# --- Kafka --------------------------------------------------------------------

# KRaft cluster id. It formats the empty kafka-data volume on first start, and
# the broker refuses to start if it later differs from the id stored there.
# Generate a new one with:
#   docker run --rm apache/kafka:4.3.1 /opt/kafka/bin/kafka-storage.sh random-uuid
KAFKA_CLUSTER_ID=95a-pdkNTwuNpLUXnbiQHA

# Host name the broker tells EXTERNAL clients to connect to; every such client
# must be able to reach it. Keep localhost unless BIND_ADDRESS exposes Kafka to
# the LAN; then use this machine's LAN IP.
KAFKA_EXTERNAL_HOST=localhost

# Partitions of each aggregate stream topic (dead-letter topics always get 1).
# Only affects topics that kafka-init has not created yet.
KAFKA_STREAM_PARTITIONS=3
